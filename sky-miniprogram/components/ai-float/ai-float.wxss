.ai-float {
  position: fixed;
  right: 24rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ai-float-hover {
  opacity: 0.8;
  transform: scale(0.95);
}
.ai-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7B61FF, #4C9AFF);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(123, 97, 255, 0.4);
}
.ai-tip {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
