/* 苍穹外卖 全局样式 */
page {
  --brand: #FFC200;
  --brand-dark: #E6A23C;
  --text-main: #333333;
  --text-sub: #999999;
  --bg-page: #F5F5F5;
  background: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FFD100, #FFB200);
  color: #333;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  line-height: 88rpx;
  height: 88rpx;
  font-size: 30rpx;
}
.btn-primary.disabled {
  background: #E5E5E5;
  color: #999;
}

/* 次按钮（描边） */
.btn-outline {
  border: 2rpx solid #DDDDDD;
  color: #666;
  border-radius: 32rpx;
  text-align: center;
  line-height: 60rpx;
  height: 60rpx;
  font-size: 26rpx;
  background: #fff;
  padding: 0 28rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 价格 */
.price {
  color: #FF5339;
  font-weight: 700;
}
.price .symbol {
  font-size: 22rpx;
}

/* 缺省页 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

/* 状态标签 */
.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
