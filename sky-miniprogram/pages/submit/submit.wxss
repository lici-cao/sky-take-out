.addr-card {
  display: flex;
  align-items: center;
}
.addr-icon { font-size: 40rpx; }
.addr-info { flex: 1; margin: 0 20rpx; }
.addr-line1 { display: flex; align-items: baseline; gap: 20rpx; }
.consignee { font-size: 30rpx; font-weight: 600; }
.phone { font-size: 26rpx; color: #666; }
.addr-detail { margin-top: 8rpx; font-size: 24rpx; color: #999; line-height: 36rpx; }
.addr-empty { flex: 1; font-size: 28rpx; color: #E6A23C; }
.addr-arrow { color: #CCC; font-size: 40rpx; }

.time-card { padding: 0 24rpx; }
.time-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  border-bottom: 2rpx solid #F7F7F7;
}
.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #DDD;
  box-sizing: border-box;
}
.radio.checked {
  border: 12rpx solid #FFC200;
}
.time-picker {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 28rpx;
}
.time-picker-label { color: #333; }
.time-picker-value { color: #E6A23C; }

.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.dish-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F9F9F9;
}
.dish-row:last-child { border-bottom: none; }
.dish-img { width: 88rpx; height: 88rpx; border-radius: 8rpx; background: #F2F2F2; }
.dish-info { flex: 1; margin-left: 16rpx; }
.dish-name { font-size: 26rpx; }
.dish-flavor { font-size: 20rpx; color: #999; margin-top: 4rpx; }
.dish-num { color: #999; font-size: 24rpx; margin-right: 20rpx; }
.dish-amount { font-size: 26rpx; font-weight: 600; min-width: 110rpx; text-align: right; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}
.row-value { color: #666; }

.remark-input {
  width: 100%;
  height: 140rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.total { flex: 1; display: flex; align-items: baseline; gap: 12rpx; }
.total-label { font-size: 26rpx; color: #666; }
.total-amount { font-size: 40rpx; font-weight: 700; color: #FF5339; }
.total-amount .symbol { font-size: 26rpx; }
.submit-btn {
  width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FFD100, #FFB200);
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.submit-btn.disabled { background: #E5E5E5; color: #999; }

/* 底部占位，避免内容被结算栏遮挡 */
.container { padding-bottom: 140rpx; }
