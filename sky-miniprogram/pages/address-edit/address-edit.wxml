<view class="container">
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请填写收货人姓名" value="{{form.consignee}}" data-field="consignee" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请填写手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">性别</text>
      <view class="sex-group">
        <view class="sex-item {{form.sex === '1' ? 'active' : ''}}" data-sex="1" bindtap="onSexTap">先生</view>
        <view class="sex-item {{form.sex === '0' ? 'active' : ''}}" data-sex="0" bindtap="onSexTap">女士</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">省市区</text>
      <input class="form-input" placeholder="如：广东省 深圳市 南山区" value="{{region}}" data-field="region" bindinput="onInput" />
    </view>
    <view class="form-row column">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="街道、小区、楼栋、门牌号等" value="{{form.detail}}" data-field="detail" bindinput="onInput" />
    </view>
    <view class="form-row">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{form.isDefault === 1}}" color="#FFC200" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="save-wrap">
    <button class="btn-primary" bindtap="onSave">保存地址</button>
    <view wx:if="{{id}}" class="delete-btn" bindtap="onDelete">删除该地址</view>
  </view>
</view>
