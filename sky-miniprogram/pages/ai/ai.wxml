<view class="chat-page">
  <!-- 消息列表 -->
  <scroll-view
    scroll-y
    class="msg-list"
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
  >
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <view class="welcome-avatar">穹</view>
      <view class="welcome-title">你好，我是小穹 🤖</view>
      <view class="welcome-desc">苍穹外卖 AI 智能助手，可以问我点餐、配送、订单等问题</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
      class="msg-row {{item.role}}"
    >
      <view wx:if="{{item.role === 'assistant'}}" class="avatar ai-avatar">穹</view>
      <view class="bubble {{item.role}}">
        <text user-select>{{item.content}}</text>
      </view>
      <view wx:if="{{item.role === 'user'}}" class="avatar user-avatar">我</view>
    </view>

    <!-- 思考中 -->
    <view wx:if="{{thinking}}" class="msg-row assistant" id="msg-thinking">
      <view class="avatar ai-avatar">穹</view>
      <view class="bubble assistant thinking">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>

    <!-- 快捷问题 -->
    <view class="quick-wrap" wx:if="{{showQuick && !thinking}}">
      <view class="quick-title">你可以问我：</view>
      <view
        wx:for="{{quickQuestions}}"
        wx:key="*this"
        class="quick-item"
        data-q="{{item}}"
        bindtap="onQuickTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="input-bar">
    <input
      class="chat-input"
      placeholder="向小穹提问…"
      confirm-type="send"
      value="{{inputValue}}"
      bindinput="onInput"
      bindconfirm="onSend"
      adjust-position="{{true}}"
    />
    <view class="send-btn {{inputValue.trim() ? 'active' : ''}}" bindtap="onSend">发送</view>
  </view>
</view>
