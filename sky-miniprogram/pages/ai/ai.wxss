.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F6FA;
}

.msg-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 欢迎区 */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
}
.welcome-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7B61FF, #4C9AFF);
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(123, 97, 255, 0.35);
}
.welcome-title {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}
.welcome-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 消息气泡 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.msg-row.user { justify-content: flex-end; }

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.ai-avatar {
  background: linear-gradient(135deg, #7B61FF, #4C9AFF);
  color: #fff;
}
.user-avatar {
  background: linear-gradient(135deg, #FFD100, #FFB200);
  color: #333;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  word-break: break-word;
}
.bubble.assistant {
  background: #fff;
  color: #333;
  margin-left: 16rpx;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.bubble.user {
  background: linear-gradient(135deg, #FFD100, #FFB200);
  color: #333;
  margin-right: 16rpx;
  border-top-right-radius: 4rpx;
}

/* 思考动画 */
.bubble.thinking {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 28rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #BBB;
  animation: bounce 1.2s infinite ease-in-out;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* 快捷问题 */
.quick-wrap { padding: 12rpx 0 12rpx 88rpx; }
.quick-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.quick-item {
  display: inline-block;
  background: #fff;
  border: 2rpx solid #E5E7FF;
  color: #7B61FF;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  margin: 0 16rpx 16rpx 0;
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.chat-input {
  flex: 1;
  height: 76rpx;
  background: #F3F4F6;
  border-radius: 38rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 20rpx;
  width: 120rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: #E5E5E5;
  color: #999;
  font-size: 28rpx;
}
.send-btn.active {
  background: linear-gradient(135deg, #7B61FF, #4C9AFF);
  color: #fff;
}
