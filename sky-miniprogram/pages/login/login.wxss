.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFD100 0%, #FFC200 30%, #F5F5F5 60%);
  display: flex;
  flex-direction: column;
}

.logo-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}
.logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 40rpx;
  background: #333;
  color: #FFD100;
  font-size: 96rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}
.app-name {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}
.app-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  letter-spacing: 4rpx;
}

.login-area {
  padding: 0 60rpx 160rpx;
}
.btn-login {
  background: #333;
  color: #FFD100;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
}
.btn-login::after {
  border: none;
}
.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}
