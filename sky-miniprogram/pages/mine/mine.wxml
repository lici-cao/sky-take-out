<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-placeholder">😋</view>
    <view class="user-info">
      <view class="nickname">{{nickName || '微信用户'}}</view>
      <view class="user-desc">品质外卖，准时送达 🛵</view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goOrders">
      <text class="menu-icon">📋</text>
      <text class="menu-label">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-label">地址管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAI">
      <text class="menu-icon">🤖</text>
      <text class="menu-label">AI 智能助手</text>
      <view class="menu-badge">NEW</view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">☎️</text>
      <text class="menu-label">联系商家</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="logout">退出登录</view>

  <!-- AI 助手悬浮入口 -->
  <ai-float bottom="60rpx" />
</view>
