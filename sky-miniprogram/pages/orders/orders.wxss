.tab-bar {
  white-space: nowrap;
  background: #fff;
  padding: 0 12rpx;
  border-bottom: 2rpx solid #F2F2F2;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  display: inline-block;
  padding: 24rpx 24rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #333;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #FFC200;
}

.order-list { padding-bottom: 40rpx; }
.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F7F7F7;
}
.order-no { font-size: 24rpx; color: #999; }

.status-tag { padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; }
.status-1 { background: #FFF2E8; color: #FF7A00; }
.status-2 { background: #FFF8DC; color: #E6A23C; }
.status-3 { background: #E8F4FF; color: #409EFF; }
.status-4 { background: #E8F7EE; color: #00B578; }
.status-5 { background: #F2F3F5; color: #909399; }
.status-6 { background: #F2F3F5; color: #C0C4CC; }

.order-dishes { padding: 16rpx 0; }
.dish-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333;
  line-height: 44rpx;
}
.dish-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 20rpx;
}
.dish-num { color: #999; }
.dish-more { font-size: 22rpx; color: #999; margin-top: 8rpx; }

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 16rpx;
  border-top: 2rpx solid #F7F7F7;
}
.order-time { font-size: 22rpx; color: #999; }
.order-amount { font-size: 34rpx; font-weight: 700; color: #333; }
.order-amount .symbol { font-size: 24rpx; }

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}
.order-actions .btn-outline {
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
}
.btn-primary-mini {
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  background: linear-gradient(135deg, #FFD100, #FFB200);
  color: #333;
  font-weight: 600;
  border-radius: 32rpx;
  padding: 0 32rpx;
}
.btn-primary-mini::after { border: none; }

.load-tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 32rpx 0;
}
.empty-btn {
  margin-top: 32rpx;
  width: 240rpx;
}
