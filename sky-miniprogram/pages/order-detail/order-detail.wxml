<view class="container" wx:if="{{order.id}}">
  <!-- 订单状态横幅 -->
  <view class="status-banner status-bg-{{order.status}}">
    <view class="status-text">{{order.statusText}}</view>
    <view class="status-desc">{{order.statusDesc}}</view>
  </view>

  <!-- 配送进度（派送中展示） -->
  <view class="card" wx:if="{{order.status === 4}}">
    <view class="card-title">配送进度</view>
    <view class="progress-line">
      <view class="p-step done"><view class="p-dot"></view><text>已下单</text></view>
      <view class="p-step done"><view class="p-dot"></view><text>商家已接单</text></view>
      <view class="p-step active"><view class="p-dot"></view><text>骑手派送中</text></view>
      <view class="p-step"><view class="p-dot"></view><text>已送达</text></view>
    </view>
  </view>

  <!-- 收货信息 -->
  <view class="card">
    <view class="card-title">收货信息</view>
    <view class="info-row">
      <text class="info-label">收货人</text>
      <text>{{order.consignee}} {{order.phone}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">收货地址</text>
      <text class="info-addr">{{order.address}}</text>
    </view>
  </view>

  <!-- 商品明细 -->
  <view class="card">
    <view class="card-title">商品明细</view>
    <view wx:for="{{order.orderDetailList}}" wx:key="id" class="dish-row">
      <image class="dish-img" src="{{item.image}}" mode="aspectFill" />
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view wx:if="{{item.dishFlavor}}" class="dish-flavor">{{item.dishFlavor}}</view>
      </view>
      <text class="dish-num">x{{item.number}}</text>
      <text class="dish-amount">¥{{item.amountText}}</text>
    </view>
    <view class="fee-row">
      <text>打包费</text>
      <text>¥{{order.packAmountText}}</text>
    </view>
    <view class="fee-row total">
      <text>合计</text>
      <text class="total-amount">¥{{order.amountText}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <view class="card-title">订单信息</view>
    <view class="info-row"><text class="info-label">订单号</text><text>{{order.number}}</text></view>
    <view class="info-row"><text class="info-label">下单时间</text><text>{{order.orderTimeText}}</text></view>
    <view class="info-row" wx:if="{{order.checkoutTime}}"><text class="info-label">支付时间</text><text>{{order.checkoutTimeText}}</text></view>
    <view class="info-row" wx:if="{{order.deliveryTime}}"><text class="info-label">送达时间</text><text>{{order.deliveryTimeText}}</text></view>
    <view class="info-row" wx:if="{{order.remark}}"><text class="info-label">备注</text><text>{{order.remark}}</text></view>
    <view class="info-row" wx:if="{{order.cancelReason}}"><text class="info-label">取消原因</text><text>{{order.cancelReason}}</text></view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button wx:if="{{order.status === 2 || order.status === 3}}" class="btn-outline" bindtap="remindOrder">催单</button>
    <button wx:if="{{order.status === 1 || order.status === 2}}" class="btn-outline" bindtap="cancelOrder">取消订单</button>
    <button wx:if="{{order.status === 1}}" class="btn-primary action-primary" bindtap="goPay">去支付</button>
    <button wx:if="{{order.status === 5 || order.status === 6}}" class="btn-primary action-primary" bindtap="repeatOrder">再来一单</button>
  </view>

  <ai-float bottom="140rpx" />
</view>

<view wx:else class="empty">
  <view class="empty-icon">📦</view>
  <view>订单加载中…</view>
</view>
