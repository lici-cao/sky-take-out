.status-banner {
  padding: 56rpx 40rpx;
  color: #fff;
}
.status-bg-1 { background: linear-gradient(135deg, #FF9F43, #FF7A00); }
.status-bg-2 { background: linear-gradient(135deg, #FFD100, #E6A23C); }
.status-bg-3 { background: linear-gradient(135deg, #4C9AFF, #409EFF); }
.status-bg-4 { background: linear-gradient(135deg, #00D09C, #00B578); }
.status-bg-5 { background: linear-gradient(135deg, #909399, #6B6E75); }
.status-bg-6 { background: linear-gradient(135deg, #C0C4CC, #A8ABB2); }
.status-text { font-size: 40rpx; font-weight: 700; }
.status-desc { margin-top: 12rpx; font-size: 24rpx; opacity: 0.9; }

.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }

/* 配送进度 */
.progress-line {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}
.p-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  color: #999;
  position: relative;
}
.p-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #DDD;
  margin-bottom: 10rpx;
}
.p-step::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: -50%;
  width: 100%;
  height: 4rpx;
  background: #DDD;
}
.p-step:first-child::before { display: none; }
.p-step.done .p-dot, .p-step.active .p-dot { background: #00B578; }
.p-step.done::before, .p-step.active::before { background: #00B578; }
.p-step.active { color: #00B578; font-weight: 600; }
.p-step.active .p-dot {
  box-shadow: 0 0 0 8rpx rgba(0, 181, 120, 0.15);
}

.info-row {
  display: flex;
  font-size: 26rpx;
  line-height: 48rpx;
}
.info-label { color: #999; width: 150rpx; flex-shrink: 0; }
.info-addr { flex: 1; }

.dish-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F9F9F9;
}
.dish-img { width: 88rpx; height: 88rpx; border-radius: 8rpx; background: #F2F2F2; }
.dish-info { flex: 1; margin-left: 16rpx; }
.dish-name { font-size: 26rpx; }
.dish-flavor { font-size: 20rpx; color: #999; margin-top: 4rpx; }
.dish-num { color: #999; font-size: 24rpx; margin-right: 20rpx; }
.dish-amount { font-size: 26rpx; font-weight: 600; min-width: 110rpx; text-align: right; }
.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding: 16rpx 0 0;
}
.fee-row.total {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.total-amount { color: #FF5339; }

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 0 24rpx env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.action-bar .btn-outline {
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
}
.action-primary {
  margin: 0;
  width: 200rpx;
  height: 72rpx;
  line-height: 72rpx;
  border: none;
  font-size: 28rpx;
}
.action-primary::after { border: none; }

.container { padding-bottom: 140rpx; }
